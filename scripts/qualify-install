#!/usr/bin/env bash
# Qualify scripts/ferry-install for <rev> on <ssh>, in a private scratch root.
#
# Usage: scripts/qualify-install <ssh> <rev> [<old-rev>]
#
# The live install (~/.local/state/ferry, ~/.local/bin/ferry) is read, never
# changed. Each invocation creates its own root with `mktemp -d` on the host
# (.local/state/ferry-qualify.XXXXXX), seeds it from the live generation in the
# pre-procedure layout, and removes only that root, and only after a PASS; a
# failed drill keeps it for inspection. Logs stay in a local directory that is
# printed at the end. <old-rev> is a revision without the source join (default
# b85eb91e); installing it must be refused.
#
# The drill proves, in order: verify-host refuses the legacy layout without
# changing it; a refused FIRST install leaves a launcher that runs the same
# binary as before; install of <rev> adopts the legacy generation as previous;
# a receipt joins caller and host to <rev> and to the executables that ran;
# rollback and forward; a refused install after a good one keeps <rev> active;
# and a second activation is refused while a holder has confirmed it owns the
# install lock. Activating <rev> on the live root is a separate, announced step.
set -euo pipefail

# Git runs only in the colocated checkout: a jj workspace has no .git, and git
# there would walk up and silently answer about another repository (~/.git).
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
[ -d "$repo_root/.git" ] || { echo "$(basename "$0"): run this from the colocated checkout (~/code/ferry), not a jj workspace" >&2; exit 1; }
unset GIT_DIR GIT_WORK_TREE
host="${1:?usage: qualify-install <ssh> <rev> [<old-rev>]}"
rev="${2:?usage: qualify-install <ssh> <rev> [<old-rev>]}"
old="${3:-b85eb91e323acc1046275537e4533180875dd1e3}"
here="$(cd "$(dirname "$0")" && pwd)"
install="$here/ferry-install"
logs="$(mktemp -d "${TMPDIR:-/tmp}/ferry-qualify.XXXXXX")"
on_host() { ssh -o BatchMode=yes "$host" "$@"; }

remote_home="$(on_host 'printf %s "$HOME"')"
remote_root="$(on_host 'mkdir -p "$HOME/.local/state" && mktemp -d "$HOME/.local/state/ferry-qualify.XXXXXX"')"
export FERRY_INSTALL_ROOT="${remote_root#"$remote_home"/}"
export FERRY_INSTALL_BIN="$FERRY_INSTALL_ROOT/bin/ferry"
passed=0
finish() {
  if [ "$passed" = 1 ]; then
    on_host "rm -rf '$remote_root'"
    echo "qualify: removed $remote_root; logs in $logs"
  else
    echo "qualify: kept $remote_root on $host for inspection; logs in $logs" >&2
  fi
}
trap finish EXIT

step() { printf '\n== %s\n' "$*"; }
fail() { echo "qualify: FAILED: $*" >&2; exit 1; }
refused() { if "$@" >"$logs/out" 2>&1; then cat "$logs/out"; fail "expected a refusal: $*"; fi; grep 'ferry-install' "$logs/out" | sed 's/^/   refused: /'; }
field() { python3 -c 'import json,sys; d=json.load(sys.stdin)
for k in sys.argv[1].split("."): d=d[k]
print(d)' "$1"; }
live() { on_host 'readlink -f ~/.local/bin/ferry; sha256sum "$(dirname "$(readlink -f ~/.local/bin/ferry)")/.ferry-wrapped" | cut -d" " -f1'; }
launcher_sha() { on_host "~/$FERRY_INSTALL_BIN host-info" | field binary_sha256; }

step "live install before (must not change)"
before="$(live)"; echo "$before"

step "seed $remote_root from the live generation, pre-procedure layout"
on_host bash -s -- "$remote_root" "$remote_home/$FERRY_INSTALL_BIN" <<'SEED'
set -euo pipefail
export PATH="/nix/var/nix/profiles/default/bin:$PATH"
root="$1"; bin="$2"
store="$(readlink -f "$HOME/.local/bin/ferry")"; store="${store%/bin/*}"
nix build --out-link "$root/installed" "$store"
mkdir -p "$(dirname "$bin")"; ln -s "$root/installed/bin/ferry" "$bin"
echo "seeded installed -> $store, bin -> installed/bin/ferry"
SEED
legacy_sha="$(launcher_sha)"; echo "   legacy launcher binary_sha256 $legacy_sha"

step "verify-host refuses the legacy layout and changes nothing"
refused "$install" verify-host "$host"
on_host "test -L '$remote_root/installed' && test ! -e '$remote_root/current' && test ! -e '$remote_root/install.lock'" ||
  fail "verify-host changed the legacy layout"

step "a refused FIRST install of $old keeps a working launcher on the same binary"
refused "$install" host "$host" "$old"
[ "$(launcher_sha)" = "$legacy_sha" ] || fail "launcher no longer runs the legacy binary"
echo "   launcher still runs $legacy_sha"

step "install $rev (the adopted generation becomes previous)"
"$install" host "$host" "$rev" 2>"$logs/install.err" | tee "$logs/install.json"
[[ "$(field current <"$logs/install.json")" == */installs/"$rev" ]] || fail "current is not $rev"
[[ "$(field previous <"$logs/install.json")" == "$remote_root/installs/"* ]] || fail "legacy generation was not kept as previous"

step "receipt joins caller and host to $rev and to the executables that ran"
nix build --out-link "$logs/caller" "git+file://$(git rev-parse --show-toplevel)?rev=$rev" 2>>"$logs/build.err"
mkdir -p "$logs/config/ferry"
printf 'host.%s = { ssh = "%s", triple = "x86_64-unknown-linux-gnu", cores = 1, features = ["linux"], binary = "%s" }\n' \
  qualify "$host" "$FERRY_INSTALL_BIN" >"$logs/config/ferry/machines.toml"
XDG_CONFIG_HOME="$logs/config" "$logs/caller/bin/ferry" run smoke --on qualify --commit "$rev" --json >"$logs/run.jsonl" ||
  fail "smoke run did not pass"
grep '"event":"receipt"' "$logs/run.jsonl" | tail -1 >"$logs/receipt.json"
r() { field "receipt.$1" <"$logs/receipt.json"; }
echo "   receipt $(r id): $(r outcome)"
[ "$(r outcome)" = ran-pass ] || fail "outcome $(r outcome)"
[ "$(r caller_source_rev)" = "$rev" ] || fail "caller_source_rev $(r caller_source_rev)"
[ "$(r host_source_rev)" = "$rev" ] || fail "host_source_rev $(r host_source_rev)"
[ "$(shasum -a 256 "$(r caller_exe)" | cut -d' ' -f1)" = "$(r caller_binary_sha256)" ] || fail "caller_exe does not hash to caller_binary_sha256"
[ "$(on_host sha256sum "$(r host_exe)" | cut -d' ' -f1)" = "$(r host_binary_sha256)" ] || fail "host_exe does not hash to host_binary_sha256"
[[ "$(r host_exe)" == /nix/store/* && "$(r caller_exe)" == /nix/store/* ]] || fail "an executable outside the Nix store ran"
echo "   caller $(r caller_exe) $(r caller_binary_sha256)"
echo "   host   $(r host_exe) $(r host_binary_sha256)"

step "rollback to the adopted generation, then forward"
"$install" rollback "$host" 2>>"$logs/install.err" >"$logs/rollback.json"
[ "$(launcher_sha)" = "$legacy_sha" ] || fail "rollback does not run the legacy binary"
"$install" rollback "$host" 2>>"$logs/install.err" >"$logs/forward.json"
"$install" verify-host "$host" "$rev" >/dev/null
echo "   back on the legacy binary, then forward on $rev"

step "a refused install after a good one keeps $rev active"
refused "$install" host "$host" "$old"
"$install" verify-host "$host" "$rev" >/dev/null && echo "   $rev still active"

step "a second activation is refused while a confirmed holder owns the install lock"
mkfifo "$logs/hold"
on_host "flock '$remote_root/install.lock' sh -c 'echo held; read _ || true'" <"$logs/hold" >"$logs/holder.out" &
holder=$!
exec 8>"$logs/hold"
for _ in $(seq 1 150); do grep -q held "$logs/holder.out" 2>/dev/null && break; sleep 0.2; done
grep -q held "$logs/holder.out" || fail "the lock holder never confirmed"
refused "$install" rollback "$host"
exec 8>&-
wait "$holder"
"$install" verify-host "$host" "$rev" >/dev/null

step "live install after (must equal before)"
after="$(live)"; echo "$after"
[ "$before" = "$after" ] || fail "the live install changed"

passed=1
printf '\nqualify: PASS %s on %s\n' "$rev" "$host"
